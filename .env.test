# Test environment variables
# File: .env.test
# Copy this file and fill in your test DB credentials.
# Never commit real credentials.

NODE_ENV=test

# PostgreSQL test database (isolated from development)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oficialia_test

# JWT (any value works for tests)
JWT_SECRET=test_secret_key_not_for_production

# Disable real email/push in tests (mocked via vi.mock)
EMAIL_TRANSPORT=smtp
INAPP_TRANSPORT=websocket

# App URL used in email templates
APP_URL=http://localhost:3000
