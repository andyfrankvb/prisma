# Variables del entorno de QA.
#
#   cp .env.qa.ejemplo .env.qa
#
# `.env.qa` NO se sube a git. Confirma que `.gitignore` lo cubra antes del primer
# commit; el patrón `.env` no atrapa por sí solo a `.env.qa`.

# ── Base de datos ────────────────────────────────────────────────────────────
#
# El host es `db`: el nombre del servicio dentro del compose, no una IP. Los
# contenedores se encuentran entre sí por ese nombre.
#
# ⚠ NUNCA pongas aquí la cadena de producción. Es la misma variable en los dos
#   entornos, así que un copiar y pegar distraído deja a las pruebas escribiendo
#   sobre los oficios reales, sin ningún aviso.
POSTGRES_USER=prisma
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=prisma_qa
DATABASE_URL=postgresql://prisma:cambiar-esta-clave@db:5432/prisma_qa

# ── Sesiones ─────────────────────────────────────────────────────────────────
#
# Distinto al de producción, a propósito: con la misma clave, una sesión abierta
# en QA valdría en producción y al revés.
#
# Generar uno:  openssl rand -base64 48
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria

# ── Dónde se sirve ───────────────────────────────────────────────────────────
#
# La IP pública del servidor mientras no haya dominio.
DOMAIN=localhost

# ── Lo que queda apagado en QA ───────────────────────────────────────────────
#
# Correos: hoy no salen ni en producción —`nodemailer` nunca se instaló—, pero se
# apaga explícitamente para que el día que se monte el envío, QA no empiece a
# escribirle a dependencias reales con datos de prueba.
EMAIL_TRANSPORT=none

# Extracción con IA: sin llave, el sistema usa solo el OCR local (Tesseract).
# Funciona igual, es un poco menos preciso al pre-llenar el formulario, y no
# genera ningún cobro. Déjala vacía salvo que se esté probando justo eso.
# OPENAI_API_KEY=

# ── Lo que NO va aquí ────────────────────────────────────────────────────────
#
# SMB_HOST, SMB_SHARE, SMB_USER, SMB_PASS son de producción y no tienen lugar en
# QA: aquí los archivos viven en un volumen local de Docker. Si aparecen en este
# archivo, alguien conectó las pruebas a la carpeta compartida de la institución.
