# ── Configuración de PRODUCCIÓN ──
# Copia este archivo como .env y llénalo. NUNCA subas el .env real a git.
#   cp .env.example .env

# ── Base de datos (servidor externo) ──
# Usuario, contraseña, host/IP, puerto y nombre de la base.
DATABASE_URL=postgres://USUARIO:CONTRASEÑA@10.X.X.X:5432/prisma

# ── Seguridad ──
# Secreto para firmar las sesiones (JWT). Usa una cadena larga y aleatoria.
# Genera una con:  openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTO_por_una_cadena_larga_aleatoria

# URL pública de la aplicación (para enlaces en correos, websocket, etc.)
APP_URL=https://prisma.tudominio.gob.mx
DOMAIN=prisma.tudominio.gob.mx

# ── SuperAdmin inicial (solo se usa al correr db:seed:admin) ──
SUPERADMIN_EMAIL=ticsadmin
SUPERADMIN_NOMBRE=Administrador TICS
SUPERADMIN_INITIAL_PASSWORD=CAMBIA_ESTO

# ── Carpeta de red SMB para los documentos (\\10.1.100.175\direccion_tics\prisma) ──
SMB_HOST=10.1.100.175
SMB_SHARE=direccion_tics/prisma
SMB_USER=USUARIO_DE_LA_CARPETA
SMB_PASS=CONTRASEÑA_DE_LA_CARPETA

# ── Correo (SMTP) ──
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.tudominio.gob.mx
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
