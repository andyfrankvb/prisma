# ─────────────────────────────────────────────────────────────
# Environment Variables — Oficialía de Partes (Production)
# File: infra/.env.example
#
# Copy to infra/.env and fill in real values.
# NEVER commit infra/.env to version control.
# ─────────────────────────────────────────────────────────────

# ── Domain ────────────────────────────────────────────────────
DOMAIN=oficialia.gobierno.mx

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=oficialia_partes
POSTGRES_USER=oficialia_app
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── API ───────────────────────────────────────────────────────
NODE_ENV=production
JWT_SECRET=CHANGE_ME_at_least_64_chars_random_string
JWT_EXPIRES_IN=8h
APP_URL=https://oficialia.gobierno.mx
# Orígenes permitidos para CORS (separados por coma si hay varios)
CORS_ORIGINS=https://oficialia.gobierno.mx

# ── Email (choose one transport) ──────────────────────────────
EMAIL_TRANSPORT=smtp
EMAIL_FROM=Oficialía de Partes <noreply@gobierno.mx>

# SMTP
SMTP_HOST=smtp.gobierno.mx
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@gobierno.mx
SMTP_PASS=CHANGE_ME_smtp_password

# SendGrid (alternative — set EMAIL_TRANSPORT=sendgrid)
# SENDGRID_API_KEY=SG.CHANGE_ME

# ── In-App Notifications ──────────────────────────────────────
INAPP_TRANSPORT=websocket
# INAPP_TRANSPORT=firebase
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── Storage ───────────────────────────────────────────────────
# 'local' uses the Docker volume; 's3' uses S3-compatible storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage

# S3-compatible (MinIO, AWS S3, Cloudflare R2, etc.)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=oficialia-pdfs
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ── SSL ───────────────────────────────────────────────────────
# Email para notificaciones de Let's Encrypt (requerido por init-ssl.sh)
CERTBOT_EMAIL=admin@gobierno.mx

# ── Backup ────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7
# Leave blank to use local volume only
BACKUP_S3_BUCKET=
# AWS_ACCESS_KEY_ID=   (reuse from storage or set separately)
# AWS_SECRET_ACCESS_KEY=

# ── Timezone ──────────────────────────────────────────────────
TZ=America/Cancun

# ── Logging ───────────────────────────────────────────────────
# Nivel de log: trace | debug | info | warn | error
# Default: info en producción, debug en desarrollo
LOG_LEVEL=info

# ── OCR ───────────────────────────────────────────────────────
# tesseract     → local, sin costo (default en desarrollo)
# google-vision → Google Cloud Vision (recomendado en producción)
OCR_PROVIDER=tesseract
# GOOGLE_VISION_API_KEY=AIza...   (requerido si OCR_PROVIDER=google-vision)
# OPENAI_API_KEY=sk-...           (opcional, mejora extracción de campos)
