# Dockerfile de desarrollo — Vite dev server con HMR
# Las dependencias se instalan en el contenedor.
# El código fuente se monta como volumen desde el host.
FROM node:20-alpine
WORKDIR /app

# Instalar dependencias (se cachean en una capa separada)
COPY frontend/package*.json ./
RUN npm install

EXPOSE 5173

CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5173"]
