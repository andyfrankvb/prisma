# ─────────────────────────────────────────────────────────────
# Dockerfile: Web (Next.js → static export served by Nginx)
# Target: infra/docker/Dockerfile.web
# ─────────────────────────────────────────────────────────────

# ── Stage 1: build Next.js ────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts

COPY frontend/ ./
RUN npm run build

# ── Stage 2: Nginx serving ────────────────────────────────────
FROM nginx:1.25-alpine AS runtime

# gettext provee envsubst — necesario para la sustitución de variables
RUN apk add --no-cache gettext

# Eliminar config por defecto
RUN rm /etc/nginx/conf.d/default.conf

# Copiar assets del build de Next.js
COPY --from=builder /app/out           /usr/share/nginx/html
# Si usas Next.js con output: 'export', los assets estáticos quedan en /out
# Si usas build normal (SSR), ajusta las rutas según corresponda:
# COPY --from=builder /app/.next/static  /usr/share/nginx/html/_next/static
# COPY --from=builder /app/public        /usr/share/nginx/html/public

# Copiar configuración principal de Nginx (sin variables)
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf

# Copiar la PLANTILLA — NO el .conf final
# Se guarda en /etc/nginx/templates/ para que el entrypoint la procese
RUN mkdir -p /etc/nginx/templates
COPY infra/nginx/app.conf.template /etc/nginx/templates/app.conf.template

# Copiar el entrypoint que ejecuta envsubst
COPY infra/nginx/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1

# El entrypoint procesa la plantilla y luego pasa el control a Nginx
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
