# ─────────────────────────────────────────────────────────────
# Dockerfile: Web (frontend Vite/React → servido por Nginx)
# Target: infra/docker/Dockerfile.web
#
# El proyecto Vite vive en frontend/ y sus componentes reales en
# src/frontend/ (en desarrollo se montan como src_frontend/; aquí
# se COPIAN porque en la imagen no hay volúmenes).
# ─────────────────────────────────────────────────────────────

# ── Stage 1: build del frontend (Vite) ────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# Dependencias (capa cacheada)
COPY frontend/package.json ./
RUN npm install --ignore-scripts

# Shell del proyecto Vite
COPY frontend/index.html frontend/vite.config.ts frontend/tsconfig.json ./
COPY frontend/src/    ./src/
COPY frontend/public/ ./public/

# Componentes reales (en dev se montan como src_frontend/)
COPY src/frontend/ ./src_frontend/

# Compilar → genera /app/dist (usamos vite directo; el type-check
# no debe frenar el despliegue)
RUN npx vite build

# ── Stage 2: Nginx sirviendo el build estático ────────────────
FROM nginx:1.25-alpine AS runtime

# gettext provee envsubst — necesario para sustituir ${DOMAIN}
RUN apk add --no-cache gettext

# Quitar config por defecto
RUN rm /etc/nginx/conf.d/default.conf

# Assets compilados por Vite
COPY --from=builder /app/dist /usr/share/nginx/html

# Config principal de Nginx (incluye el upstream app_api)
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf

# Plantilla del virtual host (el entrypoint la procesa con envsubst)
RUN mkdir -p /etc/nginx/templates
COPY infra/nginx/app.conf.template /etc/nginx/templates/app.conf.template

# Entrypoint que ejecuta envsubst y valida la config
COPY infra/nginx/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
