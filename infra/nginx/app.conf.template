# ─────────────────────────────────────────────────────────────
# Nginx: Virtual host — PRISMA (acceso por HTTP / IP)
# File: infra/nginx/app.conf.template
#
# Config SIMPLE para el primer despliegue: se entra por IP
# (http://IP-DE-LA-VM) sin dominio ni certificado.
#
# Cuando haya dominio + TLS, usa infra/nginx/app.conf.https.template
# (guardada aparte) en lugar de esta.
#
# El entrypoint sustituye ${DOMAIN} con envsubst. Las variables
# nativas de Nginx ($host, $remote_addr, …) NO se tocan.
# ─────────────────────────────────────────────────────────────

server {
    listen      80;
    listen      [::]:80;
    server_name ${DOMAIN};

    # ── Límite de subida (oficios/documentos) ─────────────────
    client_max_body_size 200M;

    # ── Health check ──────────────────────────────────────────
    location = /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # ── API ───────────────────────────────────────────────────
    location /api/ {
        limit_req zone=api_limit burst=60 nodelay;

        proxy_pass         http://app_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";

        proxy_connect_timeout  10s;
        proxy_send_timeout     60s;
        proxy_read_timeout     60s;
    }

    # ── Login — límite más estricto ───────────────────────────
    location /api/v1/auth/login {
        limit_req zone=auth_limit burst=10 nodelay;

        proxy_pass         http://app_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # ── WebSocket (notificaciones) ────────────────────────────
    location /ws {
        proxy_pass         http://app_api;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_set_header   X-Real-IP  $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── Archivos servidos por el API (documentos) ─────────────
    location /files/ {
        proxy_pass         http://app_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # ── SPA — todo lo demás va al index.html ──────────────────
    location / {
        root  /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
