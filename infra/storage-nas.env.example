# ─────────────────────────────────────────────────────────────
# Variables para guardar los archivos en un NAS / ruta de red.
# Copiá las que apliquen a tu caso dentro de infra/.env
# ─────────────────────────────────────────────────────────────

# La ruta DENTRO del contenedor no cambia (déjala así):
STORAGE_LOCAL_PATH=/app/storage

# ── Si usás NFS ──────────────────────────────────────────────
# IP o host del NAS y la ruta exportada del NAS
STORAGE_NFS_ADDR=192.168.1.50
STORAGE_NFS_PATH=/volume1/prisma/storage

# ── Si usás SMB/CIFS (comentá lo de NFS y usá esto) ─────────
# STORAGE_SMB_HOST=192.168.1.50
# STORAGE_SMB_SHARE=prisma
# STORAGE_SMB_USER=prisma_svc
# STORAGE_SMB_PASS=cambia_esto_por_una_contrasena_segura
